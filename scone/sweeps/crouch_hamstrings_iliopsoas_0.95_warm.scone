# Extension sweep: knee and hip flexor contracture (hamstrings and iliopsoas), tendon slack length x 0.95, warm start from the healthy gait
CmaOptimizer {
	signature_prefix = DATE_TIME
	signature_postfix = "HAMILI095warm"
	
	# Warm start: begin from the healthy solution (Deliverable 1) with a wider spread
	init_file = ../../results/healthy/0035_1.021_0.780.par
	use_init_file = true
	use_init_file_best_as_mean = true
	init_file_std_factor = 2
	
	SimulationObjective {
		max_duration = 10
		
		# Model used in simulation
		OpenSimModel {
			model_file = ../Human0914.osim
			
			# Optimize initial state parameters
			state_init_file = ../InitStateGait.sto
			initial_state_offset =	0~0.01<-0.5,0.5>
			initial_state_offset_exclude = "*_tx;*_ty;*_u"
			
			# Short (contracted) hamstrings and iliopsoas
			Properties {
				hamstrings_l { tendon_slack_length.factor = 0.95 }
				hamstrings_r { tendon_slack_length.factor = 0.95 }
				iliopsoas_l { tendon_slack_length.factor = 0.95 }
				iliopsoas_r { tendon_slack_length.factor = 0.95 }
			}
		}
		
		# Controller for gait, based on [Geyer & Herr 2010]
		<< ../ControllerComplexGH.scone >>
		
		# Measure for gait, minimum speed 0.5 m/s
		<< ../Measure05.scone >>
	}
}
